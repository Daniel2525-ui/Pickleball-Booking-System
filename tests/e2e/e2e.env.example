# Copy to tests/e2e/.env.e2e (git-ignored) and fill in. Never put production values here.

# Local Supabase stack (from `supabase status` or the local stack's settings)
API_URL=http://127.0.0.1:54321
ANON_KEY=
SERVICE_ROLE_KEY=

# Any long random strings; they only have to match between the app and the tests
CRON_SECRET=
STRIPE_WEBHOOK_SECRET=

# Test accounts that exist in the local stack (the admin account must have role 'admin' and is_owner = true)
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=
E2E_CUSTOMER_EMAIL=e2e-customer@example.com
E2E_CUSTOMER_PASSWORD=
E2E_CUSTOMER2_EMAIL=e2e-customer2@example.com
E2E_CUSTOMER2_PASSWORD=

# QR Ph test mode (Xendit). Only xnd_development_ keys are accepted by scripts/e2e-app.sh
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
