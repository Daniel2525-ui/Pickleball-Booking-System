# Placeholders only. Copy to .env.local (and the hosting dashboard) and fill in per client venue.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared with the Supabase cron job (Vault secret)
CRON_SECRET=a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Venue identity (defaults: Crosshair Dinkers, Butuan City)
NEXT_PUBLIC_VENUE_NAME=Venue Name
NEXT_PUBLIC_VENUE_CITY=City
# Brand colour for buttons and highlights, #RRGGBB (default #0E7C66). Text on it turns dark automatically if it is light.
NEXT_PUBLIC_BRAND_COLOR=#0E7C66
# "night" for the dark navy-and-lime customer theme; leave empty for the light theme
NEXT_PUBLIC_THEME=
# Footer contact links; leave any empty to hide it. Social links must start with https://
NEXT_PUBLIC_VENUE_PHONE=
NEXT_PUBLIC_VENUE_FACEBOOK_URL=
NEXT_PUBLIC_VENUE_INSTAGRAM_URL=
NEXT_PUBLIC_VENUE_TIKTOK_URL=
# Live address, for link previews, e.g. https://book.example.ph
NEXT_PUBLIC_SITE_URL=

# Booking emails (Resend). Leave empty to send none.
RESEND_API_KEY=
EMAIL_FROM="Venue Name <bookings@your-domain.com>"

# Sentry error monitoring. Leave the DSNs empty to keep it off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Demo only (demo/xendit branch): Xendit test-mode QR Ph replaces Stripe when the key is set
XENDIT_SECRET_KEY=xnd_development_...
# Dashboard > Settings > Webhooks > verification token (optional: the QR page confirms without it)
XENDIT_WEBHOOK_TOKEN=
