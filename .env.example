# Placeholders only. Copy to .env.local (and the hosting dashboard) and fill in per client venue.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared with the Supabase cron job (Vault secret)
CRON_SECRET=a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Venue identity (defaults: Crosshair Dinkers, Butuan City)
NEXT_PUBLIC_VENUE_NAME=Venue Name
NEXT_PUBLIC_VENUE_CITY=City
# Live address, for link previews, e.g. https://book.example.ph
NEXT_PUBLIC_SITE_URL=

# Booking emails (Resend). Leave empty to send none.
RESEND_API_KEY=
EMAIL_FROM="Venue Name <bookings@your-domain.com>"

# Sentry error monitoring. Leave the DSNs empty to keep it off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Demo only (demo/xendit branch): Xendit test-mode QR Ph replaces Stripe when the key is set
XENDIT_SECRET_KEY=xnd_development_...
# Dashboard > Settings > Webhooks > verification token (optional: the QR page confirms without it)
XENDIT_WEBHOOK_TOKEN=
